{
  "name": "dsh-teams-x",
  "version": "0.1.0",
  "description": "TeamsX for DeepSeek Harness: durable multi-agent teams (captain, members, dependency-aware tasks, mailboxes) with an all-SVG activity panel. Native to dsh 0.1.3-alpha.1 with a capability-detection compat layer.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/icons",
    "cordis.patch.yml",
    "README.md",
    "README_ZH.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke:client": "node --import ./scripts/register-css-stub.mjs scripts/client-smoke.mjs",
    "verify:flow": "node --experimental-strip-types scripts/verify-flow.mjs",
    "icons": "node --experimental-strip-types scripts/export-icons.mjs",
    "verify:icons": "node --experimental-strip-types scripts/export-icons.mjs --check",
    "verify": "pnpm typecheck && pnpm build && pnpm smoke:client && pnpm verify:flow && pnpm verify:icons"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/home/xiaoxin/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:/home/xiaoxin/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-client-connection": "link:/home/xiaoxin/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-api-session-controller": "link:/home/xiaoxin/deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-client-locale": "link:/home/xiaoxin/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "link:/home/xiaoxin/deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:/home/xiaoxin/deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-renderer": "link:/home/xiaoxin/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:/home/xiaoxin/deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/xiaoxin/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-llm": "link:/home/xiaoxin/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:/home/xiaoxin/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-subagent": "link:/home/xiaoxin/deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-system-prompt": "link:/home/xiaoxin/deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:/home/xiaoxin/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-workspace": "link:/home/xiaoxin/deepseek-harness/packages/workspace/workspace",
    "@deepseek-ai/schemastery": "link:/home/xiaoxin/deepseek-harness/vendor/schemastery",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
